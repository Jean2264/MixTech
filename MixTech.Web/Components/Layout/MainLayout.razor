@inherits LayoutComponentBase

<main>  
           <Header OnMenuClick="ToggleSidebar" />
    <div class="content">
        <Sidebar IsPinned="isSidebarPinned" />
        @Body
    </div>
</main>

@code{

    private bool isSidebarPinned= false;
    private void ToggleSidebar()
    {
        isSidebarPinned= !isSidebarPinned;
    }
}
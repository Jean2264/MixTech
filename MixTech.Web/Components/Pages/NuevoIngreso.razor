@page "/nuevo-ingreso"

<main class="nuevo-ingreso">

    <div class="nuevo-ingreso-options">
        <div class="options-title">
            <h2>Selecciones de operación</h2>
        </div>
       <div class="options">
         <ul>
            <li><button class="btn-options @(operacionSeleccionada == "ordenServicio" ? "active" : "")" 

            @onclick='()=> SeleccionarOperacion("ordenServicio")'> 
            <i class="bi bi-plus-circle sidebar-icon" aria-hidden="true"> </i>
             Orden de servicio</button></li>

            <li><button class="btn-options @(operacionSeleccionada == "presupuesto" ? "active" : "")"  @onclick='()=> SeleccionarOperacion("presupuesto")'>
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i> 
                Presupuesto</button></li>

            <li><button class="btn-options @(operacionSeleccionada == "ventaDirecta" ? "active" : "")"  @onclick='()=> SeleccionarOperacion("ventaDirecta")'>
                <i class="bi bi-cart-check" aria-hidden="true">

                </i> Venta directa</button></li>
        </ul>
       </div>
    </div>

@switch(operacionSeleccionada)
{
    case "ordenServicio":
       <div class="orden-servicio">
        <div class="orden-servicio-form">
            <form>

                <section class="section-cliente">
                    <div class="section-header">
                        <h3>Datos del cliente</h3>
                    </div>
                    <div class="cliente-tipo">

    <button type="button"
            class="btn-cliente @(esParticular ? "active" : "")"
            aria-pressed="@esParticular"
            @onclick="SeleccionarParticular">

        <i class="bi bi-person"></i>
        <span>Particular</span>

    </button>

    <button type="button"
            class="btn-cliente @(!esParticular ? "active" : "")"
            aria-pressed="@(!esParticular)"
            @onclick="SeleccionarRegistrado">

        <i class="bi bi-people"></i>
        <span>Registrado</span>

    </button>

</div>
                    <div class="cliente-contenido">

                                @if (esParticular)
                                {
                                    <div class="cliente-particular">
                                    <div class="form-group">
                                        <label for="nombre">Nombre</label>
                                        <input type="text" id="nombre" class="form-control"
                                        placeholder="Ingrese el nombre del cliente" />
                                    </div>
                                    <div class="form-group">
                                        <label for="cuit">Cuit/DNI</label>
                                        <input type="text" id="cuit" class="form-control"
                                        placeholder="Ingrese el Cuit/DNI del cliente" />
                                    </div>
                                    <div class="form-group">
                                        <label for="telefono">Telefono</label>
                                        <input type="text" id="telefono" class="form-control"
                                        placeholder="Ej: +54 9 1143019723" />
                                    </div>
                                    <div class="form-group">
                                        <label for="email">Email (opcional)</label>
                                        <input type="email" id="email" class="form-control"
                                        placeholder="Ej: example@gmail.com" />
                                    </div>
                                    </div>
                                }
                                @if(!esParticular)
                                {
                                    <div class="cliente-registrado">
                                        <div class="cliente-search"><div class="cliente-search-input"><i class="bi bi-search"></i><input placeholder="buscar cliente por nombre, cuit/dni o email"/></div><button class="btn-search">Buscar</button></div>
                                    </div>
                                }
                            </div>
                </section>
                <section class="section-recepcion"></section>
                <section class="section-dispositivos"></section>
            </form>
        </div>
        <div class="orden-servicio-resumen">
            <section class="resumen-lista"></section>
            <button class="btn-alta">Guardar ingreso</button>
        </div>
       </div>
        break;
    case "presupuesto":
        <div class="presupuesto">
            <h1>Presupuesto</h1>
        </div>
        break;
    case "ventaDirecta":
        <div class="venta-directa">
            <h1>Venta directa</h1>
        </div>
        break;
}

</main>

@code{
    private string operacionSeleccionada= "ordenServicio";
    private void SeleccionarOperacion(string operacion)
    {
        operacionSeleccionada=operacion;
    }

    private bool esParticular = true;

    private void SeleccionarParticular()
    {
        esParticular = true;
    }

    private void SeleccionarRegistrado()
    {
        esParticular = false;
    }
}